#!/usr/bin/env bash
# ast-grep 래퍼: Windows 빌드는 결과 경로를 src\a.ts 처럼 역슬래시로 출력한다 (구분자 옵션 없음).
# Git Bash 에서 그대로 쓸 수 있도록 출력의 파일 경로 부분만 / 로 바꾼다 (코드 내용은 건드리지 않음).
#   --json 출력: "file" 값 안의 \\ → /
#   텍스트 출력: 줄 맨 앞 경로(path:line:... · diff 머리줄 path)의 \ → /
# 대화형(-i/--interactive)은 화면을 직접 다루므로 그대로 실행한다.
exe="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/ast-grep.exe"
[[ -x "$exe" ]] || { echo "ast-grep 이 반입되지 않았습니다 (선택 구성요소 code-intel/ast-grep)" >&2; exit 127; }
for a in "$@"; do case "$a" in -i|--interactive) exec "$exe" "$@" ;; esac; done
"$exe" "$@" | sed -E '
  /^[[:space:]]*[[{]|"file":/ {
    :j
    s#("file": ?"[^"]*)\\\\#\1/#
    tj
    b
  }
  :t
  s#^(([A-Za-z]:)?[^:[:space:]"]*)[\]#\1/#
  tt
'
exit "${PIPESTATUS[0]}"
