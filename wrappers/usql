#!/usr/bin/env bash
# usql 래퍼: Tweak TUI 로 등록한 이름 붙은 연결을 자동으로 쓴다.
# - agent/usql.yaml (비밀번호 없음) 이 있으면 --config 로 넘긴다.
# - 비밀번호가 저장된 연결이 있으면(agent/secrets.json, DPAPI) 실행할 때만 비밀번호를 넣은 임시 설정을 만들고, 끝나면 지운다.
#   (비밀번호를 명령줄·환경변수·영구 파일에 남기지 않는다)
HOME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENT="$HOME_DIR/agent"
USQL="$HOME_DIR/bin/usql.exe"

if [[ " $* " == *" --config "* || ! -f "$AGENT/usql.yaml" ]]; then
  exec "$USQL" "$@"
fi

if [[ -f "$AGENT/secrets.json" && -f "$AGENT/connections.json" ]]; then
  tmp="$(mktemp -t oxy-usql-XXXXXX.yaml)"
  trap 'rm -f "$tmp"' EXIT
  node="${OXY_NODE:-$HOME_DIR/runtime/node/node.exe}"
  if "$node" "$(cygpath -m "$HOME_DIR/installer/connections.mjs")" usql-config "$(cygpath -m "$tmp")" --agent "$(cygpath -m "$AGENT")"; then
    "$USQL" --config "$(cygpath -m "$tmp")" "$@"
    exit $?
  fi
  echo "[usql] 저장된 연결 정보를 읽지 못해 비밀번호 없이 실행합니다" >&2
fi
exec "$USQL" --config "$(cygpath -m "$AGENT/usql.yaml")" "$@"
