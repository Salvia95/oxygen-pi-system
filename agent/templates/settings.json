{
  "shellPath": "@@OXY_SHELL_PATH@@",
  "defaultTools": ["read", "bash", "edit", "write", "grep"],

  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "provider": { "timeoutMs": 600000 }
  },

  "cacheWarming": "off",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "quietStartup": "header"
}
