# oxygen-pi-system 사이트 설정. `just configure` 가 이 파일을 agent/oxy.env 로 복사한다.
# agent/oxy.env 는 PC별 설정이므로 버전관리/번들에서 제외된다.

# 사내 vLLM OpenAI 호환 엔드포인트 (/v1 까지 포함)
OXY_VLLM_BASE_URL=http://vllm.example.internal:8000/v1
# vLLM --api-key 값. 인증이 없으면 아무 문자열이나 둔다.
OXY_VLLM_API_KEY=EMPTY

# vLLM --served-model-name 값과 정확히 일치해야 한다 (just verify 가 /v1/models 로 확인)
OXY_MODEL_CODER=qwen3.6-coder-30b
OXY_MODEL_GENERAL=qwen3.8-27b
OXY_DEFAULT_MODEL=qwen3.6-coder-30b

# 컨텍스트 길이 (vLLM --max-model-len 과 맞출 것)
OXY_CONTEXT_WINDOW=131072

# 사내 GitLab (glab)
GITLAB_HOST=gitlab.example.internal
# GITLAB_TOKEN 은 여기 적지 말고 `glab auth login` 으로 저장 권장

# 프록시를 쓰는 경우 vLLM/GitLab 호스트는 우회
# NO_PROXY=vllm.example.internal,gitlab.example.internal,localhost,127.0.0.1
