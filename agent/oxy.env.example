# oxygen-pi-system 사이트 설정. `just configure` 가 이 파일을 agent/oxy.env 로 복사한다.
# agent/oxy.env 는 PC별 설정이므로 버전관리/번들에서 제외된다.

# LLM 연결(서버 주소 · 모델 · 컨텍스트 길이 · 요청 설정)은 agent/llm.json, API 키는 agent/secrets.json(DPAPI 암호화)에 있다.
#   install.cmd 의 LLM 단계 또는 tweak.cmd 의 LLM 연결에서 설정한다 (docs/tui-spec.md §11).
#   예전 방식으로 여기에 OXY_VLLM_BASE_URL · OXY_VLLM_API_KEY · OXY_MODEL_* 를 적으면 configure 가 llm.json 으로 옮기고 지운다.

# 사내 GitLab (glab)
GITLAB_HOST=gitlab.example.internal
# GITLAB_TOKEN 은 여기 적지 말고 `glab auth login` 으로 저장 권장

# 끈 도구 사용법(skill) — 쉼표 구분 skill 이름 (agent/skill-library/<이름>). 비우면 설치된 구성요소의 skill 을 모두 켠다.
#   tweak.cmd › 도구 사용법 에서 끄면 여기에 적힌다. 적힌 skill 은 구성요소를 나중에 설치·업데이트해도 꺼진 채 남는다.
#   바꾼 뒤에는 just configure (설치 TUI·Tweak 은 저장할 때 바로 반영)
# OXY_SKILLS_OFF=terminal-session-control

# 터미널 (설치 TUI·tweak.cmd 의 PATH·바로가기에서 설정. docs/tui-spec.md §10)
#   OXY_TERMINAL_SHELL : Windows Terminal 프로필·바탕화면 바로가기가 여는 셸 git-bash(기본) · cmd · powershell
#                        pi 의 bash 도구와 psmux pane 은 이 값과 관계없이 Git Bash 를 쓴다
#   OXY_MUX            : none(기본) · psmux. psmux 면 대화형 oxy 를 폴더별 세션에서 실행 (한 번만 바로: oxy --no-mux)
#   OXY_GIT_BASH       : oxy.cmd 가 쓰는 Git Bash 경로 (설치 TUI 가 기록)
# OXY_TERMINAL_SHELL=git-bash
# OXY_MUX=none

# 프록시를 쓰는 경우 vLLM/GitLab 호스트는 우회
# NO_PROXY=vllm.example.internal,gitlab.example.internal,localhost,127.0.0.1
