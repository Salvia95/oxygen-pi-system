# 다운로드/생성물 (manifest/tools.lock.tsv 로 재현 가능)
/.cache/
/dist/
/bin/
/runtime/
/vendor/
# 선택 구성요소 원본 (재배포 금지: Oracle SQLcl, Chrome for Testing 등)
/optional/
