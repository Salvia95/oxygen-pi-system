# 다운로드/생성물 (manifest/tools.lock.tsv 로 재현 가능)
/.cache/
/dist/
/bin/
/runtime/
/vendor/
# 선택 구성요소 원본 (재배포 금지: Oracle SQLcl, Chrome for Testing 등)
/optional/
# fetch 선택 화면의 이전 선택 (PC별)
/.oxy-selection
/agent/bin/

# PC별 설정·세션·인증 (configure 로 생성)
/agent/oxy.env
/agent/settings.json
/agent/models.json
/agent/auth.json
/agent/sessions/
/agent/models-store.json
# 설치된 구성요소에 맞춰 configure / 설치 TUI 가 skill-library 에서 생성
/agent/skills/
# PC 로컬 설정·비밀 (Tweak TUI 가 생성): DB 연결, DPAPI 비밀 저장소, pi MCP 등록·로그·인증
/agent/usql.yaml
/agent/dbhub.toml
/agent/connections.json
/agent/secrets.json
/agent/llm.json
/agent/.oxy-llm-default.json
/agent/mcp.json
/agent/mcp.log*
/agent/mcp-auth.json
# oxy-jobs 작업 로그
/agent/jobs/
# configure 가 만드는 psmux 설정 (PC 의 Git Bash 경로가 들어감)
/agent/psmux.conf
